PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sidebside
JWT_SECRET=cambia_este_secreto_por_uno_seguro
JWT_EXPIRES_IN=30m
NODE_ENV=development
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
FRONTEND_URL=http://localhost:5173

# Correo (recuperacion de contrasena, contrasena temporal de usuarios nuevos,
# aviso de viaje asignado). src/utils/email.js usa el primero que este
# configurado: Resend -> SMTP -> solo log en consola.
#
# PRODUCCION: Resend (https://resend.com, gratis hasta 100 correos/dia).
# DigitalOcean bloquea los puertos SMTP, asi que Gmail no sale desde el
# Droplet. Verifica el dominio en Resend (registros DNS en Porkbun) y usa un
# remitente de ese dominio en EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM="SideBSide <no-reply@tudominio.com>"

# DESARROLLO LOCAL (opcional): Gmail por SMTP. Activa verificacion en 2 pasos
# y genera una "contrasena de aplicacion" en
# https://myaccount.google.com/apppasswords - SMTP_USER es tu correo completo,
# SMTP_PASS esa contrasena de 16 caracteres (no la normal de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Solo en produccion, detras de Caddy/nginx: numero de proxies delante de la
# app (1). Hace que el limite de intentos vea la IP real de cada usuario.
# Dejar vacio en desarrollo.
TRUST_PROXY=

# Auto-rellenado del formulario de gasto a partir de la foto del ticket
# (vision + JSON estructurado). Clave gratis en https://aistudio.google.com
# ("Get API key" -> "Create API key", sin tarjeta de credito).
GEMINI_API_KEY=
