PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sidebside
JWT_SECRET=cambia_este_secreto_por_uno_seguro
JWT_EXPIRES_IN=30m
NODE_ENV=development
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
FRONTEND_URL=http://localhost:5173

# Correo (recuperacion de contrasena, envio de contrasena temporal a usuarios
# nuevos). Con Gmail: activa verificacion en 2 pasos en la cuenta y genera
# una "contrasena de aplicacion" en https://myaccount.google.com/apppasswords
# - SMTP_USER es tu correo completo, SMTP_PASS es esa contrasena de 16
# caracteres (no la contrasena normal de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Auto-rellenado del formulario de gasto a partir de la foto del ticket
# (vision + JSON estructurado). Clave gratis en https://aistudio.google.com
# ("Get API key" -> "Create API key", sin tarjeta de credito).
GEMINI_API_KEY=
