{
  "info": {
    "name": "SideBSide API",
    "description": "Coleccion de pruebas para el backend de SideBSide (control de gastos operativos). Los tokens e IDs se capturan automaticamente via scripts en la pestana Tests/Scripts de cada request y se guardan como variables de coleccion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "admin_email",
      "value": "admin@sidebside.mx"
    },
    {
      "key": "admin_password",
      "value": "admin12345"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "operador_email",
      "value": ""
    },
    {
      "key": "operador_password",
      "value": ""
    },
    {
      "key": "token_operador",
      "value": ""
    },
    {
      "key": "categoria_id",
      "value": ""
    },
    {
      "key": "categoria_nombre",
      "value": ""
    },
    {
      "key": "gasto_id",
      "value": ""
    },
    {
      "key": "gasto_id_rechazo",
      "value": ""
    },
    {
      "key": "gasto_borrador_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"contrasena\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login admin OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token_admin', data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar operador (nuevo, requiere admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Corre \"Login admin\" primero. Genera un email unico cada vez (timestamp) para no chocar con el UNIQUE de email.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Operador Prueba\",\n  \"email\": \"{{operador_email}}\",\n  \"contrasena\": \"{{operador_password}}\",\n  \"rol\": \"operador\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('operador_email', `operador.${ts}@empresa.mx`);",
                  "pm.collectionVariables.set('operador_password', 'operador12345');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Operador creado', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login operador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Corre \"Registrar operador\" primero.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{operador_email}}\",\n  \"contrasena\": \"{{operador_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login operador OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token_operador', data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar contrasena (operador)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_operador}}"
              }
            ],
            "url": "{{baseUrl}}/auth/cambiar-contrasena",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actual\": \"{{operador_password}}\",\n  \"nueva\": \"operadorNueva123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Contrasena actualizada', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('operador_password', 'operadorNueva123');"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "description": "El JWT es stateless: esto no invalida el token realmente, solo confirma el endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
